[Unit]
Description=EasyFix backend (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=easyfix
Group=easyfix
WorkingDirectory=/opt/easyfix/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/easyfix/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8012
Restart=always
RestartSec=3

# 安全加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
